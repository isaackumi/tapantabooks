# Copy to .env.local. With no file at all the app runs entirely on the in-browser mock backend.

# "false" sends every request to the real APIs below; anything else (or unset) uses the mock backend.
NEXT_PUBLIC_USE_MOCK_API=true

# Must match App:AppId on tvs-accounting-bk.
NEXT_PUBLIC_APP_ID=app-accounting

# Hosts only; the app appends /api/v1.
NEXT_PUBLIC_BACKEND_ACCOUNTING_API_URL=https://accounting-api.example.com
NEXT_PUBLIC_BACKEND_TROVESUITE_CORE_API_URL=https://core-api.example.com

# Optional. When set, "Sign out" and expired sessions go to the Core shell's login instead of /auth/login.
NEXT_PUBLIC_FRONTEND_CORE_URL=
