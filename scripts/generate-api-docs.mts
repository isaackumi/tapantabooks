// Writes docs/API_ENDPOINTS.md from src/services/catalogue.ts.
//   npm run docs:api           regenerate
//   npm run docs:api -- --check  fail if the file is stale or the mock routes drift from the catalogue

import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { COLLECTIONS, ENDPOINTS, endpointKey, type EndpointDef } from "../src/services/catalogue.ts";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const outFile = join(root, "docs", "API_ENDPOINTS.md");
const routesFile = join(root, "src", "mock", "api", "routes.ts");
const check = process.argv.includes("--check");

const collectionByPath = new Map(Object.entries(COLLECTIONS).map(([key, path]) => [path as string, key]));

const anchor = (e: EndpointDef) => `${e.method}-${e.path}`.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const code = (s: string) => `\`${s.replace(/\|/g, "\\|")}\``;
const cell = (s: string) => s.replace(/\|/g, "\\|");

const modules: string[] = [];
for (const e of ENDPOINTS) if (!modules.includes(e.module)) modules.push(e.module);

const endpointSection = (e: EndpointDef) => {
  const lines = [`#### ${e.method} \`${e.path}\``, "", e.summary + ".", ""];
  lines.push(`- **Permission:** \`${e.permission}\``);
  lines.push(`- **Returns (\`data\`):** ${code(e.returns)}`);
  if (e.body) lines.push(`- **Body:** ${code(e.body)}`);
  const collection = collectionByPath.get(e.path);
  if (e.method === "GET" && collection) lines.push(`- **Client cache:** loads \`${collection}\` (all pages, \`size=500\`)`);
  if (e.invalidates?.length) lines.push(`- **Client reloads after success:** ${e.invalidates.map((k) => `\`${k}\``).join(", ")}`);
  if (e.query && Object.keys(e.query).length) {
    lines.push("", "| Query parameter | Meaning |", "| --- | --- |");
    for (const [name, meaning] of Object.entries(e.query)) lines.push(`| \`${name}\` | ${cell(meaning)} |`);
  }
  lines.push("");
  return lines.join("\n");
};

const render = () => {
  const out: string[] = [
    "# Accounting API endpoints",
    "",
    "<!-- Generated by `npm run docs:api` from src/services/catalogue.ts. Do not edit by hand. -->",
    "",
    `${ENDPOINTS.length} endpoints in ${modules.length} modules. Every path is relative to \`/api/v1\` on the accounting API and every call carries the`,
    "Trovesuite headers (`authorization`, `app-id`, `org-id`, `bus-id`, `loc-id`). Responses use the standard envelope; `data` is the shape",
    "listed under **Returns**. See [API_CONVENTIONS.md](./API_CONVENTIONS.md) for headers, envelope, errors and pagination,",
    "[PROCESSING_RULES.md](./PROCESSING_RULES.md) for what each write must enforce, and [DATA_MODEL.md](./DATA_MODEL.md) for the types named here.",
    "",
    "Ids always go in the query string as `{resource}_id`, never in the path. Updates are `PUT` with a body containing only the fields to change",
    "unless the body says otherwise. Sign-up and login are served by the Core Platform, not this API: see [AUTH_AND_ONBOARDING.md](./AUTH_AND_ONBOARDING.md).",
    "",
    "## Index",
    "",
    "| Module | Method | Path | Summary |",
    "| --- | --- | --- | --- |",
  ];
  for (const m of modules) {
    for (const e of ENDPOINTS.filter((x) => x.module === m)) {
      out.push(`| ${m} | ${e.method} | [\`${e.path}\`](#${anchor(e)}) | ${cell(e.summary)} |`);
    }
  }
  out.push("");
  for (const m of modules) {
    out.push(`## ${m}`, "");
    for (const e of ENDPOINTS.filter((x) => x.module === m)) out.push(`<a id="${anchor(e)}"></a>`, "", endpointSection(e));
  }
  return out.join("\n").replace(/\n{3,}/g, "\n\n").trimEnd() + "\n";
};

/** Route keys the mock backend implements, read from the handler table in routes.ts. */
const implementedRoutes = () =>
  new Set([...readFileSync(routesFile, "utf8").matchAll(/^\s+"((?:GET|POST|PUT|PATCH|DELETE) \/[^"]+)":/gm)].map((m) => m[1]));

const problems: string[] = [];

const declared = ENDPOINTS.map((e) => endpointKey(e.method, e.path));
const duplicates = declared.filter((k, i) => declared.indexOf(k) !== i);
if (duplicates.length) problems.push(`Declared twice in the catalogue: ${duplicates.join(", ")}`);

const implemented = implementedRoutes();
const missingHandlers = declared.filter((k) => !implemented.has(k));
const undocumented = [...implemented].filter((k) => !declared.includes(k));
if (missingHandlers.length) problems.push(`In the catalogue but not served by the mock backend: ${missingHandlers.join(", ")}`);
if (undocumented.length) problems.push(`Served by the mock backend but missing from the catalogue: ${undocumented.join(", ")}`);

const markdown = render();
if (check) {
  let current = "";
  try {
    current = readFileSync(outFile, "utf8");
  } catch {
    // Missing file is reported below.
  }
  if (current !== markdown) problems.push("docs/API_ENDPOINTS.md is out of date. Run `npm run docs:api`.");
} else {
  writeFileSync(outFile, markdown);
  console.log(`Wrote ${ENDPOINTS.length} endpoints to docs/API_ENDPOINTS.md`);
}

if (problems.length) {
  for (const p of problems) console.error(`✗ ${p}`);
  process.exit(1);
}
if (check) console.log(`✓ docs/API_ENDPOINTS.md is current and all ${declared.length} endpoints are served by the mock backend`);
